# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Auth (NextAuth v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# --- Supabase (database + file storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
STORAGE_BUCKET="caregiver-uploads"
# Public site URL (used for SEO metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Google OAuth (optional — enables "Continue with Google") ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Safaricom Daraja (M-Pesa) — leave empty to disable payment rails ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_B2C_INITIATOR=
DARAJA_B2C_SECURITY_CREDENTIAL=
# Platform commission taken from worker earnings (%), default 10
PLATFORM_FEE_PCT=10
