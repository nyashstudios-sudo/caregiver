datasource db {
  provider = "postgresql"
  // Runtime queries go through Supabase's transaction pooler so every
  // serverless function instance multiplexes onto the backend pool instead
  // of each burning one of the session pooler's fixed slots (EMAXCONNSESSION).
  url = env("DATABASE_URL")
  // Prisma CLI (migrate) uses this: transaction-mode pgbouncer cannot hold
  // the advisory locks migrations rely on, so migrations get a real session.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  WORKER
  ADMIN
}

/// Account lifecycle — admins can suspend abusive accounts from /admin/users.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

/// Credential vetting pipeline — workers upload, admins approve or reject.
enum CredentialStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          Role      @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  notifyByEmail Boolean   @default(true)
  lastLoginAt   DateTime?
  /// Set when the Supabase-delivered code confirms the address.
  emailVerifiedAt DateTime?
  /// Last OTP send — drives the resend throttle.
  verifySentAt    DateTime?
  /// Companion Supabase Auth user used purely for email delivery.
  authId          String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  clientBookings Booking[] @relation("ClientBookings")
  workerBookings Booking[] @relation("WorkerBookings")
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviewsWritten   Review[]  @relation("ReviewsWritten")
  reviewsReceived  Review[]  @relation("ReviewsReceived")
  wallet           Wallet?
  payments         Payment[]
  portfolio        PortfolioItem[] @relation("WorkerPortfolio")
  services         Service[]       @relation("WorkerServices")
  auditLogs        AdminAuditLog[] @relation("AuditActor")
  pushSubscriptions PushSubscription[]
  ledger           LedgerEntry[]
  taxWithholdings  TaxWithholding[]
}

/// Web Push endpoints registered by the PWA — powers message/booking alerts.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  location         String
  bio              String?
  avatarUrl        String?
  /// Set by an admin after vetting ID/qualifications — drives the public badge.
  verifiedAt       DateTime?
  /// Worker's KRA Personal Identification Number (P123456789X) — printed on
  /// the platform's withholding-tax statements. Optional by design: the
  /// platform records tax withheld either way; workers stay responsible for
  /// filing their own returns.
  kraPin           String?
  
  caretakerDetails CaretakerDetails?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CaretakerDetails {
  id                 String          @id @default(cuid())
  profileId          String          @unique
  profile            Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  hourlyRate         Float
  yearsExperience    Int
  hasFirstAid        Boolean         @default(false)
  isCertifiedMassage Boolean         @default(false)
  skillsSummary      String?
  
  certifications     Certification[]
}

model Certification {
  id                 String           @id @default(cuid())
  caretakerDetailsId String
  caretakerDetails   CaretakerDetails @relation(fields: [caretakerDetailsId], references: [id], onDelete: Cascade)
  title              String
  documentUrl        String
  issuedAt           DateTime?
  /// Admin vetting: new uploads start PENDING until reviewed.
  status             CredentialStatus @default(PENDING)
  reviewedAt         DateTime?
  /// Admin who reviewed it (plain id — survives account removal).
  reviewedBy         String?
  reviewNote         String?
}

model Booking {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User          @relation("WorkerBookings", fields: [workerId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(PENDING)
  serviceDate DateTime
  notes       String?
  /// Agreed value in KES at booking time (hourlyRate × hours).
  amount      Float?
  hours       Float?
  /// Escrow lifecycle: paid → (completed → released to worker) or (cancelled → refunded).
  paidAt      DateTime?
  releasedAt  DateTime?
  refundedAt  DateTime?
  /// Platform commission actually charged at release time (monetization ledger).
  feeAmount   Float?
  /// KRA withholding tax (ITA s.35) withheld from the worker's payout at
  /// release and remitted by the platform — shown on the worker's statement.
  whtAmount   Float?
  /// The marketplace service this booking was created from, when applicable.
  serviceId   String?
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reviews     Review[]
  payments    Payment[]
}

/// Double-sided reputation: clients rate caretakers, caretakers rate clients
/// (experience, reliability and payment) after a COMPLETED booking.
model Review {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
}

/// Per-user KES balance held by the platform (M-Pesa deposits, earnings, refunds).
model Wallet {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
}

enum PaymentKind {
  DEPOSIT         /// client → wallet (STK push top-up)
  BOOKING_PAYMENT /// client → platform (STK push), escrowed against a booking
  WITHDRAWAL      /// platform → user (B2C) from wallet balance
  REFUND          /// platform → client (B2C) after cancellation
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Every M-Pesa movement, reconciled through Daraja callbacks.
model Payment {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId          String?
  booking            Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  kind               PaymentKind
  status             PaymentStatus @default(PENDING)
  /// KES, always server-computed — never trusted from the client.
  amount             Float
  /// MSISDN in 254… form for STK/B2C rails.
  phone              String?
  checkoutRequestId String?       @unique
  /// STK MerchantRequestID or B2C OriginatorConversationID — unique per push.
  merchantRequestId String?       @unique
  mpesaReceipt       String?
  conversationId     String?
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, kind])
}

/// Every wallet movement, append-only, each row carrying the balance that
/// resulted from it — the audit trail behind deposits, escrow releases,
/// withdrawals and reversals. Money in is positive, money out negative.
enum LedgerKind {
  DEPOSIT             /// STK top-up credited to the wallet
  BOOKING_PAYMENT     /// wallet → escrow (client paid a booking from balance)
  REFUND              /// escrow → wallet (booking cancelled after payment)
  RELEASE             /// escrow → worker wallet, net of platform fee and WHT
  WITHDRAWAL          /// wallet → M-Pesa (B2C requested by the user)
  WITHDRAWAL_REVERSAL /// failed B2C restored to the wallet
}

model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         LedgerKind
  /// Signed KES — positive credits, negative debits (whole KES on the rails).
  amount       Float
  /// Wallet balance immediately after this entry (runnable balance check).
  balanceAfter Float
  bookingId    String?
  paymentId    String?
  description  String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// KRA withholding tax deducted at source when worker earnings are released
/// (Income Tax Act s.35 — the platform is the payer, so it withholds; the
/// worker files their own return and claims the withheld amount as a credit).
model TaxWithholding {
  id        String   @id @default(cuid())
  workerId  String
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  bookingId String?  @unique
  /// Escrowed booking value the income was earned on (KES, gross).
  gross     Float
  /// Platform commission withheld before tax (KES).
  fee       Float
  /// Rate applied, as a percent — snapshotted so later setting changes
  /// never rewrite history on a statement.
  whtRate   Float
  /// Tax withheld and remitted by the platform (KES, whole shillings).
  whtAmount Float
  /// What the worker actually received (gross − fee − wht), KES.
  net       Float
  /// Statement bucket, "YYYY-MM" (month of release) for KRA records.
  period    String
  createdAt DateTime @default(now())

  @@index([workerId, createdAt])
  @@index([period])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

/// Marketing / publishing pipeline — admins compose and publish from /admin.
model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  excerpt       String
  content       String
  coverImageUrl String?
  category      String?
  authorName    String     @default("Caregiver Team")
  status        PostStatus @default(DRAFT)
  tags          String[]
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}/// Messages sent from the Contact Us page.
model ContactMessage {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  handledAt  DateTime?
  createdAt  DateTime   @default(now())
}

/// Worker portfolio — previous jobs, case studies and photos that market
/// the worker's craft on their public profile and caretaker page.
model PortfolioItem {
  id          String    @id @default(cuid())
  workerId    String
  worker      User      @relation("WorkerPortfolio", fields: [workerId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  category    String?
  /// Image path served through /api/files (Supabase Storage).
  mediaUrl    String?
  clientName  String?
  location    String?
  projectUrl  String?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workerId, createdAt])
}

/// Fiverr-style service listings workers publish so clients can book a
/// defined offer (scope + price) instead of negotiating from scratch.
model Service {
  id             String    @id @default(cuid())
  workerId       String
  worker         User      @relation("WorkerServices", fields: [workerId], references: [id], onDelete: Cascade)
  title          String
  slug           String    @unique
  description    String    @db.Text
  category       String
  /// KES, integer — server-computed totals elsewhere never trust this client-side.
  priceKes       Int
  durationLabel  String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([workerId])
  @@index([active, category])
}

/// Platform-wide configuration editable by admins (monetization, toggles).
/// Falls back to env vars when a key has never been set.
model PlatformSetting {
  key         String    @id
  value       String
  updatedById String?
  updatedAt   DateTime  @updatedAt
}

/// Append-only trail of every privileged admin action (moderation, payouts,
/// verification, settings) — the backbone of platform supervision.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

/// In-app messaging pipeline between any two signed-in users.
model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([receiverId, readAt])
  @@index([senderId, createdAt])
}
